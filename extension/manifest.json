{
  "manifest_version": 3,
  "name": "Crate Digger",
  "version": "2.4.0",
  "description": "Dig on Bandcamp, SoundCloud, YouTube and Discogs, save tracks into playlists, and download them in lossless quality through Sockseek.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.bandcamp.com/*",
    "*://soundcloud.com/*",
    "*://*.soundcloud.com/*",
    "*://*.youtube.com/*",
    "*://*.discogs.com/*",
    "https://api.discogs.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Crate Digger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bandcamp.com/*",
        "*://soundcloud.com/*",
        "*://*.youtube.com/*",
        "*://*.discogs.com/*"
      ],
      "js": [
        "storage.js",
        "extractors.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Crate Digger"
    },
    "save-current": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current track to the active playlist"
    }
  }
}